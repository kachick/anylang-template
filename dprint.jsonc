{
  "json": {
    "trailingCommas": "never",
    "associations": ["**/*.{jsonc,json}"]
  },
  "markdown": {
    "tags": {
      "nix": "nix",
      "sh": "sh",
      "bash": "bash",
      "zsh": "zsh",
      "envrc": "bash",
      "shell": "sh",
      "shell-script": "sh"
    }
  },
  "yaml": {
    "quotes": "preferSingle",
    "trimTrailingWhitespaces": false
  },
  "toml": {
  },
  "sh": {
    "useTabs": true
  },
  "plugins": [
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/markdown-0.24.0.wasm",
    "https://plugins.dprint.dev/toml-0.8.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/kachick/nix-0.1.0.wasm",
    "https://plugins.dprint.dev/kachick/sh-0.1.0.wasm"
  ]
}
